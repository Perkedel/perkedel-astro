---
import MessageBoxTemplate from "@components/Messages/MessageBoxTemplate.astro";
import ButtonizedLink from '@components/ButtonizedLink.astro';
---
<MessageBoxTemplate
    severity={2}
    paragraphTitle={true}
    headingTitle={"Google is destroying APK sideloading! Your existing Galaxy will be locked down permanently!"}
    detailSummary={"Google is destroying APK sideloading! Your existing Galaxy will be locked down permanently!"}
    opens={false}
    ident={"keepAndroidOpenBox"}
    closeable={true}
    classe="hidePrint"
    >
    <div id="keepAndroidOpen"/>
    <script is:inline src="https://keepandroidopen.org/banner.js?&id=keepAndroidOpen&hidebutton=off"/>
    <p>
        <ButtonizedLink href="https://c.org/d9wtqYzxT7" OpenInNewTab={true}>Sign Petition!</ButtonizedLink>
        <ButtonizedLink href="https://keepandroidopen.org/" OpenInNewTab={true}>More Info!: <b>https://keepandroidopen.org/</b></ButtonizedLink>
    </p>
</MessageBoxTemplate>