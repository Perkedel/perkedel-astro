---
import ButtonizedLink from '@components/ButtonizedLink.astro';

export interface Props {
    headingTitle?: string;
    detailSummary?: string;
    detailSay?: string;
    severity?:number;
    classe?:string;
    ident?:string;
    paragraphTitle?:Boolean;
    opens?:Boolean;
    closeable?:Boolean;
};

const{
    headingTitle = "",
    detailSummary = "",
    detailSay = "",
    severity = 0,
    classe = "",
    ident = "",
    paragraphTitle = true,
    opens = false,
    closeable = false,
} = Astro.props.frontmatter || Astro.props as Props;
---
<!-- https://stackoverflow.com/a/47488174/9079640 -->
<div class={(
    ()=>{
        switch(severity){
            case 0:
                return "info";
            case 1:
                return "warning";
            case 2:
                return "error";
            case 3:
                return "busy";
            case 4:
                return "success";
            default:
                return "info";
        }
    }
)() + " " + classe} id={ident}>
    {paragraphTitle?<p style="font-size:1.5em;font-weight:bold;">
        {(()=>{
        switch(severity){
            case 0:
                return "";
            case 1:
                return "";
            case 2:
                return "";
            case 3:
                return "";
            case 4:
                return "";
            default:
                return "";
        }
    })() +headingTitle}
    {closeable?<Fragment>
        <!--
        https://www.w3schools.com/js/js_htmldom_elements.asp
        https://stackoverflow.com/questions/3301688/how-do-you-get-the-currently-selected-option-in-a-select-via-javascript
        https://stackoverflow.com/questions/6856871/getting-the-parent-div-of-element
        https://stackoverflow.com/questions/40686217/how-to-get-current-element-in-order-to-select-with-javascript
        https://www.w3schools.com/js/js_htmldom_css.asp
        -->
        <ButtonizedLink classe="justAside" style="float:right;" href={`javascript:invisibleElementById('${ident}')`}>✕</ButtonizedLink>

        <!-- <ButtonizedLink classe="justAside" style="float:right;" href={`javascript:document.getElementById('${ident}').style.display = 'none'`}>✕</ButtonizedLink> -->
        <!-- <ButtonizedLink classe="justAside" style="float:right;" href={`javascript:document.getElementById('${ident}').style.display = 'table'`}>✕</ButtonizedLink> -->
        <!-- <ButtonizedLink classe="justAside" style="float:right;" href={`javascript:document.getElementById('keepAndroidOpenBox').style.display = 'none'`}>✕</ButtonizedLink> -->
        <!-- <ButtonizedLink classe="justAside" style="float:right;" href={`javascript:void(0)`}>✕</ButtonizedLink> -->
        <!-- <p>AAAJA</p> -->
    </Fragment>:<Fragment>

    </Fragment>}

        </p>:<h2>{(()=>{
        switch(severity){
            case 0:
                return "";
            case 1:
                return "";
            case 2:
                return "";
            case 3:
                return "";
            case 4:
                return "";
            default:
                return "";
        }
    })() +headingTitle}
    {closeable?<Fragment>
        <!--
        https://www.w3schools.com/js/js_htmldom_elements.asp
        https://stackoverflow.com/questions/3301688/how-do-you-get-the-currently-selected-option-in-a-select-via-javascript
        https://stackoverflow.com/questions/6856871/getting-the-parent-div-of-element
        https://stackoverflow.com/questions/40686217/how-to-get-current-element-in-order-to-select-with-javascript
        https://www.w3schools.com/js/js_htmldom_css.asp
        -->
        <ButtonizedLink classe="justAside" style="float:right;" href={`javascript:document.getElementById('${ident}').style.display = 'none'`}>X</ButtonizedLink>
        <!-- <p>AAAJA</p> -->
    </Fragment>:<Fragment>

    </Fragment>}

        </h2>}
    <!-- <h2>{(()=>{
        switch(severity){
            case 0:
                return "";
            case 1:
                return "";
            case 2:
                return "";
            case 3:
                return "";
            case 4:
                return "";
            default:
                return "";
        }
    })() +headingTitle}</h2> -->
    <details open={opens?"open":null}>
        <summary set:html={detailSummary}></summary>
        <p set:html={detailSay}></p>
        <slot></slot>
    </details>

</div>
